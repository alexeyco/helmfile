# Generated by cmd/image. Do not edit.

ARG NODE_VERSION={{.Node}}

FROM docker.io/library/node:${NODE_VERSION}-alpine AS node

FROM alpine:{{.Alpine}} AS builder

ARG TARGETARCH
ARG KUBECTL_VERSION={{.Kubectl}}
ARG HELM_VERSION={{.Helm}}
ARG HELMFILE_VERSION={{.Helmfile}}
ARG HELMDIFF_VERSION={{.HelmDiff}}

RUN apk add --no-cache curl tar \
 && mkdir -p /out/plugins/helm-diff \
 && curl -fsSLo /out/kubectl "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
 && curl -fsSLo /tmp/helm.tar.gz "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" \
 && tar -xzf /tmp/helm.tar.gz -C /tmp \
 && mv "/tmp/linux-${TARGETARCH}/helm" /out/helm \
 && curl -fsSLo /tmp/helmfile.tar.gz "https://github.com/helmfile/helmfile/releases/download/v${HELMFILE_VERSION}/helmfile_${HELMFILE_VERSION}_linux_${TARGETARCH}.tar.gz" \
 && tar -xzf /tmp/helmfile.tar.gz -C /tmp \
 && mv /tmp/helmfile /out/helmfile \
 && curl -fsSLo /tmp/helm-diff.tgz "https://github.com/databus23/helm-diff/releases/download/v${HELMDIFF_VERSION}/helm-diff-linux-${TARGETARCH}.tgz" \
 && tar -xzf /tmp/helm-diff.tgz -C /out/plugins/helm-diff \
 && chmod +x /out/kubectl /out/helm /out/helmfile

FROM alpine:{{.Alpine}}
RUN apk add --no-cache libstdc++

LABEL org.opencontainers.image.title="helmfile" \
      org.opencontainers.image.source="https://github.com/alexeyco/helmfile" \
      org.opencontainers.image.description="Docker image for Kubernetes deploys in CI/CD bundling kubectl, helm, helmfile, helm-diff and Node.js" \
      org.opencontainers.image.licenses="BSD-2-Clause"

COPY --from=builder /out/kubectl /usr/local/bin/kubectl
COPY --from=builder /out/helm /usr/local/bin/helm
COPY --from=builder /out/helmfile /usr/local/bin/helmfile

COPY --from=builder /out/plugins/helm-diff /usr/local/share/helm/plugins/helm-diff

COPY --from=node /usr/local/bin/node /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

ENV HELM_DATA_HOME=/usr/local/share/helm

WORKDIR /tmp
